# Interactive zsh configuration.
export ZSH="$HOME/.oh-my-zsh"
export ENABLE_BACKGROUND_TASKS=1
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export FORCE_AUTOUPDATE_PLUGINS=true

# Completion + Oh My Zsh libraries and plugins (direct load avoids oh-my-zsh.sh update overhead).
ZSH_CUSTOM="$ZSH/custom"
ZSH_CACHE_DIR="$ZSH/cache"
plugins=(fzf-tab zsh-bat)
fpath=(
  "$ZSH_CUSTOM"/plugins/${^${(Oa)plugins}}
  "$ZSH"/{functions,completions}
  "$ZSH_CUSTOM"/{functions,completions}
  "$ZSH_CACHE_DIR/completions"
  /opt/homebrew/share/zsh/site-functions
  "$HOME/.local/share/zsh/site-functions"
  $fpath
)

ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
autoload -Uz compinit
_zcompdump_fresh=("$ZSH_COMPDUMP"(N.mh-24))
if (( $#_zcompdump_fresh )) && [[ -r "$ZSH_COMPDUMP.fpath" && "$(<"$ZSH_COMPDUMP.fpath")" == "$fpath" ]]; then
  compinit -C -d "$ZSH_COMPDUMP"
else
  mkdir -p "${ZSH_COMPDUMP:h}"
  rm -f "$ZSH_COMPDUMP"
  compinit -i -d "$ZSH_COMPDUMP"
  print -r -- "$fpath" >| "$ZSH_COMPDUMP.fpath"
  zcompile "$ZSH_COMPDUMP"
fi
unset _zcompdump_fresh

for _omz_file in "$ZSH"/lib/*.zsh(N); do source "$_omz_file"; done
for _omz_file in $plugins; do
  [[ -r "$ZSH_CUSTOM/plugins/$_omz_file/$_omz_file.plugin.zsh" ]] && source "$ZSH_CUSTOM/plugins/$_omz_file/$_omz_file.plugin.zsh"
done
for _omz_file in "$ZSH_CUSTOM"/*.zsh(N); do source "$_omz_file"; done
unset _omz_file
[[ -z "$LS_COLORS" ]] || zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Runtime & tool activation (mise owns runtimes, JAVA_HOME, npm/pypi/go CLIs).
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Cache generated shell init scripts keyed by resolved binary path.
_cached_init() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-$1-${${commands[$1]:A}//\//%}.zsh"
  if [[ ! -s "$cache" ]]; then
    rm -f "${cache:h}/init-$1-"*(N)
    "$@" >| "$cache" || { rm -f "$cache"; return 1 }
  fi
  source "$cache"
}

if [[ -o interactive && -z "$ZSH_EXECUTION_STRING" ]] && (( $+commands[fzf] )); then
  _cached_init fzf --zsh
fi

if [[ -z "$FZF_DEFAULT_COMMAND" ]]; then
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  elif (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git/*"'
  fi
fi

if [[ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ]]; then
  source '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'
fi

if [[ "$TERM" != dumb ]] && (( $+commands[starship] )); then
  _cached_init starship init zsh
fi

if (( $+commands[direnv] )); then
  _cached_init direnv hook zsh
fi

if (( $+commands[bun] )); then
  _cached_init bun completions
fi
unfunction _cached_init

# Aliases
alias pg="ping google.com"
alias c='clear'
alias x='exit'
alias fsize='du -hs'
alias lg='lazygit'
alias htop="sudo /Applications/NeoHtop.app/Contents/MacOS/NeoHtop"
alias export_gcs_creds='export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"'
alias update_agent_tools='browse update && cua-driver update --apply && cua-driver skills update'

# Run pi on global Node so per-project mise Node versions don't break pi's launcher.
pi() {
  local node_bin pi_install="$HOME/.pi/agent/install"
  node_bin=$(mise -C ~ which node) || return
  PI_MANAGED_INSTALL_ROOT="$pi_install" \
    "$node_bin" "$pi_install/releases/$(<"$pi_install/current-version")/node_modules/.bin/pi" "$@"
}

# Local secrets (unmanaged by chezmoi)
[[ -r "$HOME/.zshrc.secrets" ]] && source "$HOME/.zshrc.secrets"

# Route Antigravity CLI and desktop apps to the Vertex ADC service account without overriding other GCP tools.
# AGY_GCP_CREDENTIALS and AGY_GCP_PROJECT come from ~/.zshrc.secrets.
agy() {
  AGY_ADC_AUTH=true \
  GOOGLE_APPLICATION_CREDENTIALS="$AGY_GCP_CREDENTIALS" \
  GOOGLE_CLOUD_PROJECT="$AGY_GCP_PROJECT" \
  GOOGLE_CLOUD_QUOTA_PROJECT="$AGY_GCP_PROJECT" \
  GOOGLE_CLOUD_LOCATION="global" \
    command agy "$@"
}

if [[ -n "${ANTIGRAVITY_RESOLVING_ENVIRONMENT:-}" ]] || \
   ([[ -n "${VSCODE_RESOLVING_ENVIRONMENT:-}" ]] && [[ "$(ps -o comm= -p $PPID 2>/dev/null)" == *Antigravity* ]]); then
  export AGY_ADC_AUTH=true
  export GOOGLE_APPLICATION_CREDENTIALS="$AGY_GCP_CREDENTIALS"
  export GOOGLE_CLOUD_PROJECT="$AGY_GCP_PROJECT"
  export GOOGLE_CLOUD_QUOTA_PROJECT="$AGY_GCP_PROJECT"
  export GOOGLE_CLOUD_LOCATION="global"
fi


