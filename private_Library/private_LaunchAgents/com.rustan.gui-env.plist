<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rustan.gui-env</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>eval "$(mise env -s zsh)"; for name in PATH JAVA_HOME EXA_API_KEY; do val=${(P)name}; [ -n "$val" ] &amp;&amp; /bin/launchctl setenv "$name" "$val"; done</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
